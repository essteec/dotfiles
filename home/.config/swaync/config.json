{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,

  "positionX": "right",
  "positionY": "top",
  
  "control-center-positionX": "right",
  "control-center-positionY": "none",

  "control-center-width": 420,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,

  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  
  "fit-to-screen": true,
  "relative-timestamps": true,
  
  "notification-window-width": 366,
  
  "keyboard-shortcuts": true,
  
  "notification-grouping": true,
  
  "image-visibility": "when-available",
  
  "transition-time": 100,
  
  "hide-on-clear": false,
  "hide-on-action": true,
  
  "text-empty": "No Notifications",
  
  "script-fail-notify": true,
  
  "scripts": {
    "example-script": {
      "app-name": "example.app.id",
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    },
    "example-action-script": {
      "app-name": "example.app.id",
      "exec": "echo 'Do something actionable!'",
      "urgency": "Normal",
      "run-on": "action"
    }
  },
  
  "notification-visibility": {
    "volume": {
      "state": "transient",
      "app-name": "System",
      "summary": "Volume|Volume muted"
    },
    "brightness": {
      "state": "transient",
      "app-name": "System",
      "summary": "Brightness"
    }
  },
  
  "widgets": [
    "menubar",
    "backlight",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "menubar": {
      "menu#appearance-buttons": {
        "label": "Look & Feel", 
        "position": "right",
        "actions": [ 
          {
            "label": "Gtk theme",
            "command": "swaync-client -cp && nwg-look"
          },
          {
            "label": "Kvantum theme",
            "command": "swaync-client -cp && kvantummanager"
          },
          {
            "label": "Fonts",
            "command": "swaync-client -cp && font-manager"
          },
          {
            "label": "Qt theme",
            "command": "swaync-client -cp && qt6ct"
          },
          {
            "label": "Icons",
            "command": "swaync-client -cp && gtk3-icon-browser"
          }
        ]
      },
      "menu#system-buttons": {
        "label": "System",
        "position": "right",
        "actions": [ 
          {
            "label": "Power",
            "command": "swaync-client -cp && power-menu.sh"
          },
          {
            "label": "Battery",
            "command": "swaync-client -cp && battery-menu.sh"
          },
          {
            "label": "Blue Light",
            "command": "swaync-client -cp && bluelight-menu.sh"
          },
          {
            "label": "Wallpaper",
            "command": "swaync-client -cp && wall-picker.sh"
          },
          {
            "label": "Backup",
            "command": "swaync-client -cp && timeshift-launcher"
          }
        ]
      },

      "menu#launcher-buttons": {
        "label": "Launchers",
        "position": "left",
        "actions": [ 
          {
            "label": "Run App",
            "command": "swaync-client -cp && rofi -show drun"
          },
          {
            "label": "Window Switcher",
            "command": "swaync-client -cp && rofi -show window -selected-row $(hyprctl activeworkspace -j | jq -r .windows) -kb-accept-entry Alt_L -kb-row-down Alt_L+Tab -kb-row-up Shift-Tab -theme ~/.config/rofi/themes/style5_variant.rasi"
          },
          {
            "label": "Emoji Pick",
            "command": "swaync-client -cp && rofi -modi emoji -show emoji -matching 'normal' -theme ~/.config/rofi/themes/launcher/style-1.rasi"
          },
          {
            "label": "Clipboard",
            "command": "swaync-client -cp && cliphist list | rofi -dmenu -theme ~/.config/rofi/themes/style5_variant.rasi | cliphist decode | wl-copy"
          },
          {
            "label": "Media Player",
            "command": "swaync-client -cp && media-player.sh"
          }
        ]
      },

      "menu#sysmonitor-buttons": {
        "label": "Monitor",
        "position": "left",
        "actions": [ 
          {
            "label": "Mission Center",
            "command": "swaync-client -cp && missioncenter"
          },
          {
            "label": "Btop",
            "command": "swaync-client -cp && kitty -e btop"
          },
          {
            "label": "Nvidia-smi",
            "command": "swaync-client -cp && kitty -e my-nvidia-smi.sh"
          },
          {
            "label": "Nvtop",
            "command": "swaync-client -cp && kitty -e nvtop"
          },
          {
            "label": "Htop",
            "command": "swaync-client -cp && kitty -e htop"
          }
        ]
      }
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠",
      "min": 1,
      "device": "intel_backlight"
    },
    "mpris": {
      "blacklist": [],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": false,
      "image-size": 32,
      "image-radius": 4
    }
  }
}
